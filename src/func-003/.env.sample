# Azure OpenAI Service
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION="2024-06-01"
LLM_MODEL="gpt-4o"
TEMPERATURE=0.2

# Azure AI Search / Cognitive Search
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME="rex-index"
EMBEDDING_MODEL="text-embedding-3-large"
TOP_K=10 #optional number of top results to return
K_NEAREST_NEIGHBORS=7 #optional k nearest neighbors for the search

# General
DEBUG=False #optional
TIMEOUT=60 #optional
HISTORIC_LENGTH=5 #optional historic length for the search
