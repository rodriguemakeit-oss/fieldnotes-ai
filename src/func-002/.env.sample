# Azure OpenAI Service
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_VERSION="2024-06-01"

# Azure AI Search / Cognitive Search
AZURE_SEARCH_SERVICE_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME="rex-index"
EMBEDDING_MODEL="text-embedding-3-large"

# PostgreSQL
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
SQL_QUERY='SELECT * FROM "ViewAllRex";'

# General
SCHEDULE="0 */30 * * * *" # optional, cron schedule for the job
BATCH_UPLOAD_SIZE=100 #optional batch upload size (can go up to 1000 according to Microsoft API)
DEBUG=False # optional
TIMEOUT=160 # optional
SLEEP_RATE_LIMIT=120 # optional, sleep time in seconds to avoid rate limit errors
